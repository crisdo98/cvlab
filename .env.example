# CV Web Application Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Application Configuration
# ============================================================================
ENVIRONMENT=production
PYTHONPATH=/app/backend
DATA_DIR=/app/data
CV_DIR=/app/cv
EXPORTS_DIR=/app/exports

# ============================================================================
# LLM Configuration
# ============================================================================

# Enable/disable LLM features globally
LLM_ENABLED=true

# LLM Provider Selection
# Options: openai, anthropic, bedrock, local
LLM_PROVIDER=openai

# ============================================================================
# OpenAI Configuration
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Model selection (optional, defaults to gpt-4)
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
# OPENAI_MODEL=gpt-4

# ============================================================================
# Anthropic Configuration
# ============================================================================
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Model selection (optional, defaults to claude-3-opus-20240229)
# Options: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================================================
# AWS Bedrock Configuration
# ============================================================================
# AWS credentials for Bedrock access
# Option 1: Use explicit credentials
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token  # Optional, for temporary credentials

# Option 2: Use IAM role (recommended for EC2/ECS deployments)
# No credentials needed - the container will use the IAM role

# AWS region for Bedrock (defaults to us-east-1)
# AWS_REGION=us-east-1

# Model selection (optional, defaults to claude-3-opus)
# Supported models:
# - Claude: claude-3-opus, claude-3-sonnet, claude-3-haiku, claude-2.1, claude-2
# - Llama: llama2-13b, llama2-70b, llama3-8b, llama3-70b
# - Titan: titan-text-express, titan-text-lite, titan-text-premier
# Or use full model ID: anthropic.claude-3-opus-20240229-v1:0
# BEDROCK_MODEL=claude-3-opus

# ============================================================================
# Local Model Configuration (Ollama)
# ============================================================================
# Base URL for Ollama service
# OLLAMA_BASE_URL=http://ollama:11434

# Model selection (optional, defaults to llama2)
# Options: llama2, mistral, codellama, or any model available in Ollama
# OLLAMA_MODEL=llama2

# ============================================================================
# Advanced LLM Settings
# ============================================================================
# Temperature (0.0-1.0, higher = more creative)
# LLM_TEMPERATURE=0.7

# Maximum tokens in response
# LLM_MAX_TOKENS=2000

# Request timeout in seconds
# LLM_TIMEOUT=60

# Retry configuration
# LLM_RETRY_ATTEMPTS=3
# LLM_RETRY_DELAY=2

# ============================================================================
# Privacy and Security
# ============================================================================
# Require user consent before sending data to external services
# LLM_REQUIRE_CONSENT=true

# Enable audit logging for LLM requests
# LLM_AUDIT_LOG=true

# ============================================================================
# Feature Toggles
# ============================================================================
# Enable/disable specific LLM features
# LLM_FEATURE_CONTENT_GENERATION=true
# LLM_FEATURE_OPTIMIZATION=true
# LLM_FEATURE_JOB_TAILORING=true
# LLM_FEATURE_GRAMMAR_CHECK=true
# LLM_FEATURE_ATS_ANALYSIS=true
# LLM_FEATURE_AI_PARSING=true

# ============================================================================
# Notes
# ============================================================================
# - Never commit this file with real API keys to version control
# - Use .env for local development
# - Use environment variables or secrets management for production
# - Rotate API keys regularly (every 90 days recommended)
# - Monitor usage and costs in provider dashboards
# - Use local models for sensitive or confidential CVs
